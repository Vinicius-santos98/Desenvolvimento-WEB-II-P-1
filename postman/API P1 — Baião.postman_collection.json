              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 - situação cadastrado(a)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Resposta traz o registro com id\", function () {",
                  "    pm.expect(json.situation.id).to.be.a(\"number\");",
                  "});",
                  "// guarda o id criado: as próximas requisições da pasta usam {{createdSituationId}}",
                  "pm.collectionVariables.set(\"createdSituationId\", json.situation.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar paginado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/situations?page=1&limit=2",
              "host": [
                "{{host}}"
              ],
              "path": [
                "situations"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "2"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 - listagem\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Resposta paginada (PaginationService)\", function () {",
                  "    pm.expect(json.data).to.be.an(\"array\");",
                  "    pm.expect(json.currentPage).to.be.a(\"number\");",
                  "    pm.expect(json.lastPage).to.be.a(\"number\");",
                  "    pm.expect(json.totalRecords).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Respeita o limit da URL\", function () {",
                  "    pm.expect(json.data.length).to.be.at.most(2);",
                  "});"
                ]
              }
            }
          ]
        },
